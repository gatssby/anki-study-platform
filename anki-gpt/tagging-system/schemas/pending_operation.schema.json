{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersistedTaggingOperation",
  "type": "object",
  "required": [
    "operation_id",
    "timestamp",
    "created_at",
    "operation_type",
    "target",
    "tags",
    "status",
    "origin",
    "confirmed_by_user"
  ],
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "pattern": "^tagop-"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "operation_type": {
      "enum": [
        "add_tags",
        "remove_tags"
      ]
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/allowed_tag"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "pending_addon_execution",
        "applied",
        "partially_applied",
        "failed"
      ]
    },
    "origin": {
      "type": "string"
    },
    "confirmed_by_user": {
      "type": "boolean",
      "const": true
    },
    "confirmation_message_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_confirmation": {
      "$ref": "#/$defs/execution_confirmation"
    }
  },
  "$defs": {
    "allowed_tag": {
      "enum": [
        "prio:alta",
        "prio:media",
        "prio:baixa",
        "avaliar",
        "precisa_melhorar",
        "overkill",
        "duplicado",
        "bom_card"
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "deck"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "deck"
            },
            "deck": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "note_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "note_ids"
            },
            "note_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "execution_confirmation": {
      "type": "object",
      "required": [
        "status",
        "executed_at",
        "affected_note_ids",
        "affected_count",
        "errors"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "applied",
            "partially_applied",
            "failed"
          ]
        },
        "executed_at": {
          "type": "string",
          "format": "date-time"
        },
        "addon_profile": {
          "type": "string"
        },
        "affected_note_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "affected_count": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
