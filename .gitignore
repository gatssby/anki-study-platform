# Secrets and machine-local configuration
.env
.env.*
!.env.example
!**/.env.example
**/tagging_token.txt
**/auth_token.txt
**/access_token.txt
**/refresh_token.txt
**/tokens.json
**/*cookie*
**/storage_state.json
**/*storage_state*.json
**/rclone.conf
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.secrets/

# Python, Node, editors and operating systems
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/node_modules/
**/.DS_Store
**/.idea/
**/.vscode/

# Persistent/runtime state
**/data/
**/state/
**/work/
**/files/
**/output/
**/outputs/
**/uploads/
**/media/
**/transcriptions/
**/transcricoes/
**/sessions/
**/logs/
**/backups/
**/snapshots/
**/indexes/
**/indices/
**/imports/
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.log
**/*.log.*
**/network_log.json
**/*.har

# Anki collections and exported packages
**/*.anki2
**/*.anki21
**/*.colpkg
**/*.apkg

# Private study source documents
**/*.pdf
**/*.xlsx
**/*.xls

# Generated browser/build artifacts
**/.playwright/
**/.playwright-cli/
**/playwright-report/
**/test-results/
**/dist/
**/build/
**/*.egg-info/

# Raw rollback material stays outside Git
**/*.bak
**/*.bak-*
**/*~

# Explicitly keep artificial contracts and fixtures.
!contracts/fixtures/
!contracts/fixtures/**
!contracts/jsonschema/
!contracts/jsonschema/**
!contracts/openapi/
!contracts/openapi/**
!tests/fixtures/
